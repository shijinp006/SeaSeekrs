generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  SEO
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  email        String    @unique
  name         String
  passwordHash String    @db.VarChar(255)
  role         Role      @default(SEO)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

/// One row per signed-in browser. The cookie holds the session id; only its SHA-256 is kept here.
model Session {
  id         String   @id
  userId     String   @db.Char(36)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?  @db.VarChar(300)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// Failed and successful sign-ins, for rate limiting
model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  email     String
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// A section of the website. No row, or a null `published`: the text in src/lib/content.ts is shown.
model Entry {
  key         String    @id
  draft       Json?
  published   Json?
  updatedBy   String?
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

model Media {
  id         String   @id @default(uuid()) @db.Char(36)
  path       String   @unique
  name       String
  alt        String   @default("") @db.VarChar(255)
  draftAlt   String?  @db.VarChar(255)
  decorative Boolean  @default(false)
  uploaded   Boolean  @default(false)
  width      Int
  height     Int
  size       Int
  createdAt  DateTime @default(now())
}

model Post {
  id            String    @id @default(uuid()) @db.Char(36)
  slug          String    @unique
  publishedSlug String?   @unique
  draft         Json
  published     Json?
  dirty         Boolean   @default(true)
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?
}

/// Each time drafts were put on the website
model Publish {
  id      Int      @id @default(autoincrement())
  by      String
  changes Int
  at      DateTime @default(now())
}

# Copy to .env and fill in. Never commit .env.

# Letters and digits only in the passwords:  openssl rand -hex 20
MYSQL_DATABASE=seaseekers
MYSQL_USER=seaseekers
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql://seaseekers:<MYSQL_PASSWORD>@127.0.0.1:3307/seaseekers
# Hosted (TiDB Cloud): mysql://<user>:<password>@<host>:4000/seaseekers?sslaccept=strict   (strict: encrypted and checked)

# Signs the session JWT. At least 32 characters:  openssl rand -base64 48
AUTH_SECRET=

SITE_URL=https://seaseakersyachts.com
UPLOAD_DIR=uploads
# On Vercel uploads go to a Blob store instead: connecting one to the project sets BLOB_READ_WRITE_TOKEN or BLOB_STORE_ID.
# BLOB_ACCESS=public only if the store was made public.
# false only to open a production build over plain http
COOKIE_SECURE=true

# How many reverse proxies stand in front of the app (the visitor's address is read from X-Forwarded-For)
PROXY_HOPS=1

# debug, info, warn, error or silent
LOG_LEVEL=info

# First accounts, created once when there are no users yet. Passwords: 12 characters or more.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SEO_EMAIL=
SEED_SEO_PASSWORD=
